{
  "name": "dartsma",
  "version": "1.0.0",
  "description": "Application de matchs de fléchettes en direct avec détection caméra flèche par flèche façon Dartsmind",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "darts",
    "dartsmind",
    "webrtc",
    "computer-vision",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}
